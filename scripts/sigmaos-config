#!/bin/bash
# SigmaOS System Configuration Tool
# Inspired by arch-chroot and other distribution tools

set -e

VERSION="0.5.0"
CONFIG_DIR="/etc/sigmaos"
VAR_DIR="/var/lib/sigmaos"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Initialize SigmaOS configuration
init_config() {
    info "Initializing SigmaOS configuration..."
    
    mkdir -p "$CONFIG_DIR"
    mkdir -p "$CONFIG_DIR/desktop"
    mkdir -p "$CONFIG_DIR/performance"
    mkdir -p "$CONFIG_DIR/security"
    mkdir -p "$VAR_DIR"
    
    # Create default configuration files
    if [ ! -f "$CONFIG_DIR/config.conf" ]; then
        cat > "$CONFIG_DIR/config.conf" << 'EOF'
# SigmaOS Main Configuration
# Version: 0.5.0

[system]
hostname=sigmaos
timezone=UTC
locale=en_US.UTF-8

[performance]
cpu_governor=performance
swappiness=10
dirty_ratio=15

[desktop]
default_de=
compositor=true
effects=high

[network]
ipv6=true
firewall=true
EOF
        info "Created default configuration"
    fi
    
    info "SigmaOS configuration initialized"
}

# Apply performance profile
apply_performance() {
    local profile="$1"
    
    info "Applying performance profile: $profile"
    
    case "$profile" in
        performance)
            echo "performance" > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true
            sysctl vm.swappiness=10
            sysctl vm.dirty_ratio=15
            sysctl vm.dirty_background_ratio=5
            ;;
        balanced)
            echo "ondemand" > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true
            sysctl vm.swappiness=60
            sysctl vm.dirty_ratio=20
            ;;
        powersave)
            echo "powersave" > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || true
            sysctl vm.swappiness=100
            sysctl vm.dirty_ratio=30
            ;;
        *)
            error "Unknown profile: $profile"
            return 1
            ;;
    esac
    
    info "Performance profile applied"
}

# Apply desktop configuration
apply_desktop() {
    local de="$1"
    
    info "Applying desktop configuration: $de"
    
    case "$de" in
        kde)
            if [ -f "$CONFIG_DIR/desktop/kde.conf" ]; then
                info "Applying KDE configuration"
                # Apply KDE-specific settings
            fi
            ;;
        gnome)
            if [ -f "$CONFIG_DIR/desktop/gnome.conf" ]; then
                info "Applying GNOME configuration"
                # Apply GNOME-specific settings
            fi
            ;;
        xfce)
            if [ -f "$CONFIG_DIR/desktop/xfce.conf" ]; then
                info "Applying XFCE configuration"
                # Apply XFCE-specific settings
            fi
            ;;
        *)
            error "Unknown desktop: $de"
            return 1
            ;;
    esac
    
    info "Desktop configuration applied"
}

# Show system status
status() {
    info "=== SigmaOS System Status ==="
    
    echo ""
    echo "Version: $VERSION"
    echo "Config Directory: $CONFIG_DIR"
    echo "Var Directory: $VAR_DIR"
    echo ""
    
    if [ -f "$CONFIG_DIR/config.conf" ]; then
        echo "Current Configuration:"
        grep -v "^#" "$CONFIG_DIR/config.conf" | grep -v "^$"
    fi
    
    echo ""
    echo "System Information:"
    echo "  Kernel: $(uname -r)"
    echo "  Uptime: $(uptime -p)"
    echo "  Memory: $(free -h | grep Mem | awk '{print $3 "/" $2}')"
    echo "  CPU: $(nproc) cores"
}

# Generate system report
report() {
    info "Generating SigmaOS system report..."
    
    local report_file="/tmp/sigmaos-report-$(date +%Y%m%d-%H%M%S).txt"
    
    {
        echo "=== SigmaOS System Report ==="
        echo "Generated: $(date)"
        echo "Version: $VERSION"
        echo ""
        echo "=== System Information ==="
        uname -a
        echo ""
        echo "=== Memory ==="
        free -h
        echo ""
        echo "=== Disk ==="
        df -h
        echo ""
        echo "=== CPU ==="
        lscpu | grep -E "Model name|CPU\(s\)|Thread"
        echo ""
        echo "=== Services ==="
        systemctl list-units --type=service --state=running
        echo ""
        echo "=== Network ==="
        ip addr show
        echo ""
        echo "=== SigmaOS Configuration ==="
        if [ -f "$CONFIG_DIR/config.conf" ]; then
            cat "$CONFIG_DIR/config.conf"
        fi
    } > "$report_file"
    
    info "Report saved to: $report_file"
}

# Update SigmaOS
update() {
    info "Updating SigmaOS..."
    
    # Update system packages
    pacman -Syu --noconfirm
    
    # Update SigmaOS library if installed
    if command -v sigmaos &> /dev/null; then
        info "SigmaOS CLI is installed"
    fi
    
    info "SigmaOS updated"
}

# Show help
help() {
    cat << EOF
SigmaOS System Configuration Tool v$VERSION

Usage: sigmaos-config <command> [options]

Commands:
    init            Initialize SigmaOS configuration
    status          Show system status
    apply <type>    Apply configuration (performance|desktop)
    report          Generate system report
    update          Update SigmaOS
    help            Show this help

Examples:
    sigmaos-config init
    sigmaos-config apply performance
    sigmaos-config apply desktop kde
    sigmaos-config status
    sigmaos-config report

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    init)
        init_config
        ;;
    status)
        status
        ;;
    apply)
        if [ -z "$2" ]; then
            error "Usage: sigmaos-config apply <type> [name]"
            exit 1
        fi
        case "$2" in
            performance)
                apply_performance "$3"
                ;;
            desktop)
                apply_desktop "$3"
                ;;
            *)
                error "Unknown type: $2"
                exit 1
                ;;
        esac
        ;;
    report)
        report
        ;;
    update)
        update
        ;;
    help|--help|-h)
        help
        ;;
    *)
        help
        exit 1
        ;;
esac
