#!/bin/bash
# SigmaOS Keyring Management
# Manages SigmaOS GPG keys for package verification

set -e

VERSION="0.5.0"
KEYRING_DIR="/etc/sigmaos/keyring"
KEYRING_FILE="$KEYRING_DIR/sigmaos.gpg"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Initialize keyring
init_keyring() {
    info "Initializing SigmaOS keyring..."
    
    mkdir -p "$KEYRING_DIR"
    
    if [ ! -f "$KEYRING_FILE" ]; then
        info "Creating new keyring..."
        gpg --homedir "$KEYRING_DIR" --batch --gen-key << EOF
Key-Type: RSA
Key-Length: 4096
Name-Real: SigmaOS Package Signing
Name-Email: sigmaos@sigmaos.local
Expire-Date: 0
%no-protection
EOF
        info "Keyring created"
    else
        info "Keyring already exists"
    fi
}

# Import key
import_key() {
    local key_file="$1"
    
    if [ -z "$key_file" ]; then
        error "Usage: sigmaos-keyring import <key-file>"
        exit 1
    fi
    
    if [ ! -f "$key_file" ]; then
        error "Key file not found: $key_file"
        exit 1
    fi
    
    info "Importing key from: $key_file"
    gpg --homedir "$KEYRING_DIR" --import "$key_file"
    info "Key imported"
}

# List keys
list_keys() {
    info "SigmaOS keyring keys:"
    
    if [ ! -f "$KEYRING_FILE" ]; then
        warn "Keyring not initialized"
        return
    fi
    
    gpg --homedir "$KEYRING_DIR" --list-keys
}

# Export key
export_key() {
    local key_id="$1"
    local output_file="$2"
    
    if [ -z "$key_id" ]; then
        error "Usage: sigmaos-keyring export <key-id> [output-file]"
        exit 1
    fi
    
    if [ -z "$output_file" ]; then
        output_file="sigmaos-key-${key_id}.asc"
    fi
    
    info "Exporting key: $key_id"
    gpg --homedir "$KEYRING_DIR" --export --armor "$key_id" > "$output_file"
    info "Key exported to: $output_file"
}

# Verify package
verify_package() {
    local pkg_file="$1"
    local sig_file="$2"
    
    if [ -z "$pkg_file" ]; then
        error "Usage: sigmaos-keyring verify <package-file> [signature-file]"
        exit 1
    fi
    
    if [ ! -f "$pkg_file" ]; then
        error "Package file not found: $pkg_file"
        exit 1
    fi
    
    info "Verifying package: $pkg_file"
    
    if [ -z "$sig_file" ]; then
        sig_file="${pkg_file}.sig"
    fi
    
    if [ -f "$sig_file" ]; then
        gpg --homedir "$KEYRING_DIR" --verify "$sig_file" "$pkg_file"
    else
        warn "Signature file not found, cannot verify"
    fi
}

# Show help
help() {
    cat << EOF
SigmaOS Keyring Management v$VERSION

Usage: sigmaos-keyring <command> [options]

Commands:
    init                Initialize keyring
    import <file>       Import a key
    list                List keys in keyring
    export <id> [file]  Export a key
    verify <pkg> [sig]  Verify a package signature
    help                Show this help

Examples:
    sudo sigmaos-keyring init
    sudo sigmaos-keyring import key.asc
    sigmaos-keyring list
    sudo sigmaos-keyring export ABC12345 sigmaos-key.asc
    sigmaos-keyring verify package.pkg.tar.zst

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    init)
        init_keyring
        ;;
    import)
        import_key "$2"
        ;;
    list)
        list_keys
        ;;
    export)
        export_key "$2" "$3"
        ;;
    verify)
        verify_package "$2" "$3"
        ;;
    help|--help|-h)
        help
        ;;
    *)
        help
        exit 1
        ;;
esac
