#!/bin/bash
# SigmaOS News Feed
# Displays SigmaOS news and updates (inspired by Arch News)

set -e

VERSION="0.5.0"
NEWS_URL="https://github.com/AaryanSinghChauhan09/Sigma/releases"
NEWS_CACHE="/var/cache/sigmaos/news"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
header() { echo -e "${CYAN}=== $1 ===${NC}"; }

# Fetch news from GitHub releases
fetch_news() {
    mkdir -p "$NEWS_CACHE"
    
    info "Fetching SigmaOS news..."
    
    if command -v curl &> /dev/null; then
        curl -s "$NEWS_URL" > "$NEWS_CACHE/releases.html" 2>/dev/null || warn "Failed to fetch news"
    elif command -v wget &> /dev/null; then
        wget -q -O "$NEWS_CACHE/releases.html" "$NEWS_URL" 2>/dev/null || warn "Failed to fetch news"
    else
        error "Neither curl nor wget available"
        return 1
    fi
    
    info "News cached in $NEWS_CACHE"
}

# Display news
show_news() {
    header "SigmaOS News"
    
    if [ ! -f "$NEWS_CACHE/releases.html" ]; then
        fetch_news
    fi
    
    if [ -f "$NEWS_CACHE/releases.html" ]; then
        # Parse and display releases
        echo "Recent SigmaOS releases:"
        echo ""
        grep -o "Release v[0-9.]*" "$NEWS_CACHE/releases.html" | head -5 | while read release; do
            echo "  $release"
        done
        echo ""
        echo "Full releases: $NEWS_URL"
    else
        warn "News not available offline"
        echo "Visit: $NEWS_URL"
    fi
}

# Show latest version
show_version() {
    header "SigmaOS Version"
    
    if [ -f /etc/sigmaos/version ]; then
        cat /etc/sigmaos/version
    else
        echo "SigmaOS $VERSION"
    fi
    
    echo ""
    echo "Library version: $VERSION"
}

# Check for important news
check_important() {
    header "Important News"
    
    # Check for any critical updates or security notices
    # This would typically be a curated list
    
    echo "No critical news at this time."
    echo "Check full news for updates."
}

# Show help
help() {
    cat << EOF
SigmaOS News Feed v$VERSION

Usage: sigmaos-news <command>

Commands:
    fetch               Fetch latest news
    show                Display news
    version             Show SigmaOS version
    important           Show important news only
    help                Show this help

Examples:
    sigmaos-news fetch
    sigmaos-news show
    sigmaos-news version

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    fetch)
        fetch_news
        ;;
    show)
        show_news
        ;;
    version)
        show_version
        ;;
    important)
        check_important
        ;;
    help|--help|-h)
        help
        ;;
    *)
        show_news
        ;;
esac
