#!/bin/bash
# SigmaOS ISO Testing Script
# Automated testing of built ISO in QEMU

set -e

VERSION="0.5.0"
ISO_PATH="build/iso/sigmaos-0.5.0-x86_64.iso"
TEST_RESULTS="/tmp/sigmaos-test-results"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
header() { echo -e "${BLUE}=== $1 ===${NC}"; }

# Check prerequisites
check_prereqs() {
    header "Checking Prerequisites"
    
    local missing=()
    
    command -v qemu-system-x86_64 &> /dev/null || missing+=("qemu-system-x86_64")
    command -v xorriso &> /dev/null || missing+=("xorriso")
    
    if [ ${#missing[@]} -gt 0 ]; then
        error "Missing prerequisites: ${missing[*]}"
        echo "Install with: sudo pacman -S qemu xorriso"
        exit 1
    fi
    
    info "All prerequisites satisfied"
}

# Check ISO exists
check_iso() {
    header "Checking ISO"
    
    if [ ! -f "$ISO_PATH" ]; then
        error "ISO not found: $ISO_PATH"
        echo "Build it first with: ./scripts/build-iso-archiso.sh"
        exit 1
    fi
    
    local size=$(du -h "$ISO_PATH" | cut -f1)
    info "ISO found: $ISO_PATH ($size)"
}

# Test UEFI boot
test_uefi() {
    header "Testing UEFI Boot"
    
    mkdir -p "$TEST_RESULTS"
    
    info "Starting QEMU with UEFI..."
    timeout 120 qemu-system-x86_64 \
        -m 2048 \
        -bios /usr/share/ovmf/x64/OVMF.fd \
        -cdrom "$ISO_PATH" \
        -nographic \
        -serial file:"$TEST_RESULTS/uefi-boot.log" \
        || true
    
    if [ -f "$TEST_RESULTS/uefi-boot.log" ]; then
        info "UEFI boot log saved to: $TEST_RESULTS/uefi-boot.log"
        
        # Check for successful boot indicators
        if grep -q "SigmaOS" "$TEST_RESULTS/uefi-boot.log"; then
            info "UEFI boot: SigmaOS detected"
        else
            warn "UEFI boot: SigmaOS not detected in logs"
        fi
    fi
}

# Test BIOS boot
test_bios() {
    header "Testing BIOS Boot"
    
    info "Starting QEMU with BIOS..."
    timeout 120 qemu-system-x86_64 \
        -m 2048 \
        -cdrom "$ISO_PATH" \
        -nographic \
        -serial file:"$TEST_RESULTS/bios-boot.log" \
        || true
    
    if [ -f "$TEST_RESULTS/bios-boot.log" ]; then
        info "BIOS boot log saved to: $TEST_RESULTS/bios-boot.log"
        
        if grep -q "SigmaOS" "$TEST_RESULTS/bios-boot.log"; then
            info "BIOS boot: SigmaOS detected"
        else
            warn "BIOS boot: SigmaOS not detected in logs"
        fi
    fi
}

# Verify ISO structure
verify_structure() {
    header "Verifying ISO Structure"
    
    local mount_point="/tmp/sigmaos-iso-mount"
    mkdir -p "$mount_point"
    
    info "Mounting ISO..."
    mount -o loop "$ISO_PATH" "$mount_point"
    
    # Check for essential files
    local required=("boot/grub/grub.cfg" "boot/vmlinuz-linux" "boot/initramfs-linux.img")
    
    for file in "${required[@]}"; do
        if [ -f "$mount_point/$file" ]; then
            info "✓ Found: $file"
        else
            error "✗ Missing: $file"
        fi
    done
    
    umount "$mount_point"
    rmdir "$mount_point"
}

# Generate test report
generate_report() {
    header "Test Report"
    
    local report_file="/tmp/sigmaos-test-report-$(date +%Y%m%d-%H%M%S).txt"
    
    {
        echo "SigmaOS ISO Test Report"
        echo "Generated: $(date)"
        echo "Version: $VERSION"
        echo "ISO: $ISO_PATH"
        echo ""
        echo "=== Test Results ==="
        echo ""
        echo "UEFI Boot: $([ -f $TEST_RESULTS/uefi-boot.log ] && echo "Tested (see logs)" || echo "Not tested")"
        echo "BIOS Boot: $([ -f $TEST_RESULTS/bios-boot.log ] && echo "Tested (see logs)" || echo "Not tested")"
        echo ""
        echo "=== Log Files ==="
        if [ -d "$TEST_RESULTS" ]; then
            ls -la "$TEST_RESULTS"
        fi
    } > "$report_file"
    
    info "Report saved to: $report_file"
    cat "$report_file"
}

# Show help
help() {
    cat << EOF
SigmaOS ISO Testing Tool v$VERSION

Usage: sigmaos-test-iso <command>

Commands:
    check               Check prerequisites
    verify              Verify ISO structure
    test-uefi           Test UEFI boot in QEMU
    test-bios           Test BIOS boot in QEMU
    full                Run all tests
    report              Generate test report
    help                Show this help

Examples:
    sigmaos-test-iso check
    sigmaos-test-iso verify
    sigmaos-test-iso test-uefi
    sigmaos-test-iso full

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    check)
        check_prereqs
        ;;
    verify)
        check_iso
        verify_structure
        ;;
    test-uefi)
        check_iso
        test_uefi
        ;;
    test-bios)
        check_iso
        test_bios
        ;;
    full)
        check_prereqs
        check_iso
        verify_structure
        test_uefi
        test_bios
        generate_report
        ;;
    report)
        generate_report
        ;;
    help|--help|-h)
        help
        ;;
    *)
        help
        exit 1
        ;;
esac
