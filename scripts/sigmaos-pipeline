#!/bin/bash
# SigmaOS Automated Build Pipeline
# Complete automated build and test pipeline for SigmaOS

set -e

VERSION="0.5.0"
BUILD_DIR="./build"
LOG_DIR="$BUILD_DIR/logs"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
header() { echo -e "${BLUE}=== $1 ===${NC}"; }

# Initialize build environment
init_build() {
    header "Initializing Build Environment"
    
    mkdir -p "$BUILD_DIR"
    mkdir -p "$LOG_DIR"
    mkdir -p "$BUILD_DIR/iso"
    mkdir -p "$BUILD_DIR/work"
    mkdir -p "$BUILD_DIR/profile"
    
    info "Build environment initialized"
}

# Check system requirements
check_requirements() {
    header "Checking System Requirements"
    
    local missing=()
    
    # Check for Arch Linux
    if [ ! -f /etc/arch-release ]; then
        warn "Not running on Arch Linux - some features may not work"
    fi
    
    # Check for required tools
    command -v pacman &> /dev/null || missing+=("pacman")
    command -v mkarchiso &> /dev/null || missing+=("mkarchiso")
    command -v xorriso &> /dev/null || missing+=("xorriso")
    command -v mksquashfs &> /dev/null || missing+=("mksquashfs")
    
    if [ ${#missing[@]} -gt 0 ]; then
        error "Missing required tools: ${missing[*]}"
        echo "Install with: sudo pacman -S ${missing[*]}"
        exit 1
    fi
    
    info "All requirements satisfied"
}

# Build SigmaOS library
build_library() {
    header "Building SigmaOS Library"
    
    info "Running cargo test..."
    cargo test > "$LOG_DIR/library-test.log" 2>&1 || {
        error "Library tests failed"
        return 1
    }
    
    info "Building release..."
    cargo build --release > "$LOG_DIR/library-build.log" 2>&1 || {
        error "Library build failed"
        return 1
    }
    
    info "Library built successfully"
}

# Build SigmaOS packages
build_packages() {
    header "Building SigmaOS Packages"
    
    if [ ! -d "packages" ]; then
        warn "No packages directory found"
        return 0
    fi
    
    for pkg_dir in packages/*; do
        if [ -d "$pkg_dir" ] && [ -f "$pkg_dir/PKGBUILD" ]; then
            local pkg_name=$(basename "$pkg_dir")
            info "Building package: $pkg_name"
            
            cd "$pkg_dir"
            makepkg -s > "$LOG_DIR/${pkg_name}-build.log" 2>&1 || {
                warn "Failed to build $pkg_name"
            }
            cd - > /dev/null
        fi
    done
    
    info "Package build complete"
}

# Build ISO
build_iso() {
    header "Building SigmaOS ISO"
    
    if [ ! -f "scripts/build-iso-archiso.sh" ]; then
        error "ISO build script not found"
        return 1
    fi
    
    bash scripts/build-iso-archiso.sh > "$LOG_DIR/iso-build.log" 2>&1 || {
        error "ISO build failed"
        return 1
    }
    
    info "ISO built successfully"
}

# Run ISO tests
test_iso() {
    header "Testing SigmaOS ISO"
    
    if [ ! -f "scripts/sigmaos-test-iso" ]; then
        warn "ISO test script not found"
        return 0
    fi
    
    bash scripts/sigmaos-test-iso verify > "$LOG_DIR/iso-verify.log" 2>&1 || {
        warn "ISO verification failed"
    }
    
    info "ISO tests complete"
}

# Generate build report
generate_report() {
    header "Build Report"
    
    local report_file="$LOG_DIR/build-report-$(date +%Y%m%d-%H%M%S).txt"
    
    {
        echo "SigmaOS Build Report"
        echo "Generated: $(date)"
        echo "Version: $VERSION"
        echo ""
        echo "=== Build Results ==="
        echo ""
        echo "Library:"
        [ -f target/release/libsigma_system.so ] && echo "  ✓ Release build" || echo "  ✗ Release build failed"
        echo ""
        echo "ISO:"
        ls -lh "$BUILD_DIR/iso"/*.iso 2>/dev/null || echo "  No ISO found"
        echo ""
        echo "Logs:"
        ls -la "$LOG_DIR"
    } > "$report_file"
    
    info "Report saved to: $report_file"
    cat "$report_file"
}

# Full pipeline
full_pipeline() {
    header "SigmaOS Full Build Pipeline"
    
    init_build
    check_requirements
    build_library
    build_packages
    build_iso
    test_iso
    generate_report
    
    header "Pipeline Complete"
    info "All steps completed successfully"
}

# Show help
help() {
    cat << EOF
SigmaOS Automated Build Pipeline v$VERSION

Usage: sigmaos-pipeline <command>

Commands:
    init                Initialize build environment
    check               Check system requirements
    library             Build SigmaOS library
    packages            Build SigmaOS packages
    iso                  Build SigmaOS ISO
    test                Test SigmaOS ISO
    report              Generate build report
    full                Run full pipeline
    help                Show this help

Examples:
    sigmaos-pipeline init
    sigmaos-pipeline check
    sigmaos-pipeline full

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    init)
        init_build
        ;;
    check)
        check_requirements
        ;;
    library)
        build_library
        ;;
    packages)
        build_packages
        ;;
    iso)
        build_iso
        ;;
    test)
        test_iso
        ;;
    report)
        generate_report
        ;;
    full)
        full_pipeline
        ;;
    help|--help|-h)
        help
        ;;
    *)
        help
        exit 1
        ;;
esac
