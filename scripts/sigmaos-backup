#!/bin/bash
# SigmaOS Backup Tool
# System backup and restore functionality

set -e

VERSION="0.5.0"
BACKUP_DIR="/var/lib/sigmaos/backups"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }
header() { echo -e "${BLUE}=== $1 ===${NC}"; }

# Create backup
create_backup() {
    local name="$1"
    
    if [ -z "$name" ]; then
        name="sigmaos-$(date +%Y%m%d-%H%M%S)"
    fi
    
    info "Creating backup: $name"
    
    mkdir -p "$BACKUP_DIR"
    local backup_path="$BACKUP_DIR/$name"
    
    mkdir -p "$backup_path"
    
    # Backup system configuration
    info "Backing up system configuration..."
    if [ -d /etc/sigmaos ]; then
        cp -r /etc/sigmaos "$backup_path/"
    fi
    
    # Backup fstab
    if [ -f /etc/fstab ]; then
        cp /etc/fstab "$backup_path/"
    fi
    
    # Backup package list
    pacman -Q > "$backup_path/packages.txt"
    
    # Backup GRUB config
    if [ -f /boot/grub/grub.cfg ]; then
        cp /boot/grub/grub.cfg "$backup_path/"
    fi
    
    # Create backup metadata
    cat > "$backup_path/backup.json" << EOF
{
    "name": "$name",
    "date": "$(date -Iseconds)",
    "kernel": "$(uname -r)",
    "hostname": "$(hostname)"
}
EOF
    
    # Create compressed archive
    info "Creating compressed archive..."
    cd "$BACKUP_DIR"
    tar -czf "$name.tar.gz" "$name"
    rm -rf "$name"
    
    info "Backup created: $backup_path.tar.gz"
}

# List backups
list_backups() {
    info "SigmaOS backups:"
    
    if [ ! -d "$BACKUP_DIR" ]; then
        warn "No backups found"
        return
    fi
    
    for backup in "$BACKUP_DIR"/*.tar.gz; do
        if [ -f "$backup" ]; then
            local name=$(basename "$backup" .tar.gz)
            local size=$(du -h "$backup" | cut -f1)
            echo "  $name ($size)"
        fi
    done
}

# Restore backup
restore_backup() {
    local name="$1"
    
    if [ -z "$name" ]; then
        error "Usage: sigmaos-backup restore <backup-name>"
        exit 1
    fi
    
    local backup_file="$BACKUP_DIR/$name.tar.gz"
    
    if [ ! -f "$backup_file" ]; then
        error "Backup not found: $name"
        exit 1
    fi
    
    info "Restoring backup: $name"
    
    warn "This will restore system configuration"
    read -p "Continue? (yes/no): " confirm
    
    if [ "$confirm" != "yes" ]; then
        info "Restore cancelled"
        exit 0
    fi
    
    # Extract backup
    local temp_dir="/tmp/sigmaos-restore-$$"
    mkdir -p "$temp_dir"
    
    tar -xzf "$backup_file" -C "$temp_dir"
    
    # Restore configuration
    if [ -d "$temp_dir/$name/sigmaos" ]; then
        cp -r "$temp_dir/$name/sigmaos"/* /etc/sigmaos/
        info "SigmaOS configuration restored"
    fi
    
    # Restore fstab
    if [ -f "$temp_dir/$name/fstab" ]; then
        cp "$temp_dir/$name/fstab" /etc/fstab
        info "fstab restored"
    fi
    
    # Restore GRUB
    if [ -f "$temp_dir/$name/grub.cfg" ]; then
        cp "$temp_dir/$name/grub.cfg" /boot/grub/grub.cfg
        info "GRUB configuration restored"
    fi
    
    # Cleanup
    rm -rf "$temp_dir"
    
    info "Backup restored successfully"
    warn "You may need to reboot for some changes to take effect"
}

# Schedule automatic backup
schedule_backup() {
    local interval="$1"
    
    if [ -z "$interval" ]; then
        interval="daily"
    fi
    
    info "Scheduling automatic backup: $interval"
    
    local cron_file="/etc/cron.d/sigmaos-backup"
    
    case "$interval" in
        daily)
            echo "0 2 * * * root /usr/local/bin/sigmaos-backup create" > "$cron_file"
            ;;
        weekly)
            echo "0 2 * * 0 root /usr/local/bin/sigmaos-backup create" > "$cron_file"
            ;;
        hourly)
            echo "0 * * * * root /usr/local/bin/sigmaos-backup create" > "$cron_file"
            ;;
        *)
            error "Invalid interval: $interval (use: daily, weekly, hourly)"
            exit 1
            ;;
    esac
    
    info "Backup scheduled: $cron_file"
}

# Show help
help() {
    cat << EOF
SigmaOS Backup Tool v$VERSION

Usage: sigmaos-backup <command> [options]

Commands:
    create [name]       Create a new backup
    list                List all backups
    restore <name>      Restore a backup
    schedule <interval> Schedule automatic backups (daily|weekly|hourly)
    help                Show this help

Examples:
    sudo sigmaos-backup create
    sudo sigmaos-backup create my-backup
    sigmaos-backup list
    sudo sigmaos-backup restore sigmaos-20250101
    sudo sigmaos-backup schedule daily

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    create)
        create_backup "$2"
        ;;
    list)
        list_backups
        ;;
    restore)
        restore_backup "$2"
        ;;
    schedule)
        schedule_backup "$2"
        ;;
    help|--help|-h)
        help
        ;;
    *)
        help
        exit 1
        ;;
esac
