#!/bin/bash
# SigmaOS System Update Tool
# Inspired by Arch Linux pacman and system update workflows

set -e

VERSION="0.5.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Full system update
full_update() {
    info "Starting full system update..."
    
    # Update package databases
    info "Updating package databases..."
    pacman -Sy
    
    # Update system packages
    info "Updating system packages..."
    pacman -Su --noconfirm
    
    # Update SigmaOS library if installed
    if command -v sigmaos &> /dev/null; then
        info "SigmaOS CLI is installed - check for updates via cargo"
    fi
    
    info "Full system update complete"
}

# Security update
security_update() {
    info "Checking for security updates..."
    
    # Arch Security Advisories
    if command -v arch-audit &> /dev/null; then
        arch-audit
    else
        warn "arch-audit not installed. Install with: pacman -S arch-audit"
    fi
    
    # Update system
    pacman -Syu --noconfirm
    
    info "Security update complete"
}

# Kernel update
kernel_update() {
    info "Checking for kernel updates..."
    
    pacman -Sy linux linux-firmware --noconfirm
    
    # Update initramfs
    mkinitcpio -P
    
    # Update GRUB
    if command -v grub-mkconfig &> /dev/null; then
        grub-mkconfig -o /boot/grub/grub.cfg
    fi
    
    info "Kernel update complete"
    warn "Reboot to apply kernel changes"
}

# Check for updates
check_updates() {
    info "Checking for available updates..."
    
    pacman -Sy
    pacman -Qu
    
    local count=$(pacman -Qu | wc -l)
    info "$count packages can be updated"
}

# Rollback to previous version
rollback() {
    warn "Rollback requires SigmaOS release management"
    sigmaos-release list 2>/dev/null || error "sigmaos-release not available"
}

# Show help
help() {
    cat << EOF
SigmaOS System Update Tool v$VERSION

Usage: sigmaos-update <command>

Commands:
    full           Full system update (packages, kernel, configs)
    security       Security-focused update
    kernel         Kernel and bootloader update
    check          Check for available updates
    rollback       Rollback to previous release
    help           Show this help

Examples:
    sudo sigmaos-update full
    sudo sigmaos-update security
    sudo sigmaos-update kernel
    sigmaos-update check

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    full)
        full_update
        ;;
    security)
        security_update
        ;;
    kernel)
        kernel_update
        ;;
    check)
        check_updates
        ;;
    rollback)
        rollback
        ;;
    help|--help|-h)
        help
        ;;
    *)
        help
        exit 1
        ;;
esac
