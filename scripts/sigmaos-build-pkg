#!/bin/bash
# SigmaOS Package Build Script
# Builds SigmaOS-specific packages for the repository

set -e

VERSION="0.5.0"
REPO_DIR="/var/lib/sigmaos/repo"
BUILD_DIR="/var/lib/sigmaos/build"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Initialize build environment
init_build() {
    info "Initializing SigmaOS package build environment..."
    
    mkdir -p "$REPO_DIR"
    mkdir -p "$BUILD_DIR"
    mkdir -p "$REPO_DIR/x86_64"
    
    # Create repo database
    if [ ! -f "$REPO_DIR/sigmaos.db.tar.gz" ]; then
        repo-add "$REPO_DIR/sigmaos.db.tar.gz"
        info "Created repository database"
    fi
    
    info "Build environment initialized"
}

# Build a package
build_pkg() {
    local pkg_dir="$1"
    
    if [ ! -d "$pkg_dir" ]; then
        error "Package directory not found: $pkg_dir"
        exit 1
    fi
    
    local pkg_name=$(basename "$pkg_dir")
    info "Building package: $pkg_name"
    
    cd "$pkg_dir"
    
    # Check if PKGBUILD exists
    if [ ! -f "PKGBUILD" ]; then
        error "PKGBUILD not found in $pkg_dir"
        exit 1
    fi
    
    # Build package
    makepkg -s
    
    # Move package to repository
    local pkg_file=$(ls *.pkg.tar.zst 2>/dev/null | head -1)
    if [ -z "$pkg_file" ]; then
        error "Package build failed: no package file found"
        exit 1
    fi
    
    cp "$pkg_file" "$REPO_DIR/x86_64/"
    
    # Update repository
    repo-add "$REPO_DIR/sigmaos.db.tar.gz" "$REPO_DIR/x86_64/$pkg_file"
    
    info "Package built and added to repository: $pkg_file"
    
    cd - > /dev/null
}

# Build all packages
build_all() {
    local base_dir="$1"
    
    if [ -z "$base_dir" ]; then
        base_dir="packages"
    fi
    
    info "Building all SigmaOS packages from: $base_dir"
    
    for pkg_dir in "$base_dir"/*; do
        if [ -d "$pkg_dir" ] && [ -f "$pkg_dir/PKGBUILD" ]; then
            build_pkg "$pkg_dir"
        fi
    done
    
    info "All packages built successfully"
}

# List packages
list_pkgs() {
    info "SigmaOS packages:"
    
    if [ -d "packages" ]; then
        for pkg_dir in packages/*; do
            if [ -d "$pkg_dir" ]; then
                echo "  $(basename $pkg_dir)"
            fi
        done
    else
        warn "No packages directory found"
    fi
}

# Show help
help() {
    cat << EOF
SigmaOS Package Build System v$VERSION

Usage: sigmaos-build-pkg <command> [options]

Commands:
    init                    Initialize build environment
    build <package>         Build a specific package
    build-all [dir]         Build all packages (default: packages/)
    list                    List available packages
    help                    Show this help

Examples:
    sudo sigmaos-build-pkg init
    sudo sigmaos-build-pkg build packages/sigmaos-base
    sudo sigmaos-build-pkg build-all
    sigmaos-build-pkg list

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    init)
        init_build
        ;;
    build)
        if [ -z "$2" ]; then
            error "Usage: sigmaos-build-pkg build <package-directory>"
            exit 1
        fi
        build_pkg "$2"
        ;;
    build-all)
        build_all "$2"
        ;;
    list)
        list_pkgs
        ;;
    help|--help|-h)
        help
        ;;
    *)
        help
        exit 1
        ;;
esac
