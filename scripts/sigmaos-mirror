#!/bin/bash
# SigmaOS Mirror Configuration
# Configures package mirrors for SigmaOS

set -e

VERSION="0.5.0"
MIRROR_FILE="/etc/pacman.d/sigmaos-mirrorlist"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Generate mirror list
generate_mirrors() {
    info "Generating SigmaOS mirror list..."
    
    mkdir -p "$(dirname "$MIRROR_FILE")"
    
    cat > "$MIRROR_FILE" << 'EOF'
# SigmaOS Mirror List
# Generated by sigmaos-mirror
# Version: 0.5.0

# Primary SigmaOS Repository
Server = https://github.com/AaryanSinghChauhan09/Sigma/releases/download/packages/$repo/os/$arch

# Arch Linux mirrors (for base packages)
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://archlinux.mirror.garr.it/$repo/os/$arch
EOF
    
    info "Mirror list generated: $MIRROR_FILE"
}

# Update pacman.conf to use SigmaOS mirrors
update_pacman_conf() {
    info "Updating pacman.conf for SigmaOS..."
    
    local pacman_conf="/etc/pacman.conf"
    
    # Backup original
    if [ ! -f "$pacman_conf.backup" ]; then
        cp "$pacman_conf" "$pacman_conf.backup"
        info "Backed up original pacman.conf"
    fi
    
    # Add SigmaOS repository if not present
    if ! grep -q "\[sigmaos\]" "$pacman_conf"; then
        cat >> "$pacman_conf" << 'EOF'

[sigmaos]
SigLevel = Optional
Server = file:///var/lib/sigmaos/repo/$repo/os/$arch
EOF
        info "Added SigmaOS repository to pacman.conf"
    fi
    
    info "pacman.conf updated"
}

# Test mirrors
test_mirrors() {
    info "Testing mirror connectivity..."
    
    # Test Arch mirrors
    if curl -s --connect-timeout 5 https://mirrors.kernel.org/archlinux/core/os/x86_64/ > /dev/null; then
        info "kernel.org mirror: OK"
    else
        warn "kernel.org mirror: FAILED"
    fi
    
    # Test SigmaOS repo (local)
    if [ -d "/var/lib/sigmaos/repo" ]; then
        info "SigmaOS local repository: OK"
    else
        warn "SigmaOS local repository: NOT FOUND"
    fi
}

# Rank mirrors by speed
rank_mirrors() {
    info "Ranking mirrors by speed..."
    
    if command -v rankmirrors &> /dev/null; then
        rankmirrors -n 6 /etc/pacman.d/mirrorlist
        info "Mirrors ranked"
    else
        warn "rankmirrors not installed. Install with: pacman -S pacman-contrib"
    fi
}

# Show help
help() {
    cat << EOF
SigmaOS Mirror Configuration v$VERSION

Usage: sigmaos-mirror <command>

Commands:
    generate            Generate mirror list
    update-pacman       Update pacman.conf
    test                Test mirror connectivity
    rank                Rank mirrors by speed
    help                Show this help

Examples:
    sudo sigmaos-mirror generate
    sudo sigmaos-mirror update-pacman
    sigmaos-mirror test
    sudo sigmaos-mirror rank

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    generate)
        generate_mirrors
        ;;
    update-pacman)
        update_pacman_conf
        ;;
    test)
        test_mirrors
        ;;
    rank)
        rank_mirrors
        ;;
    help|--help|-h)
        help
        ;;
    *)
        help
        exit 1
        ;;
esac
