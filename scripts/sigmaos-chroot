#!/bin/bash
# SigmaOS Chroot Tool
# Chroot into a SigmaOS installation, similar to arch-chroot

set -e

VERSION="0.5.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; }

# Chroot into SigmaOS installation
chroot_sigmaos() {
    local mount_point="$1"
    
    if [ -z "$mount_point" ]; then
        mount_point="/mnt"
    fi
    
    if [ ! -d "$mount_point" ]; then
        error "Mount point not found: $mount_point"
        exit 1
    fi
    
    info "Chrooting into SigmaOS at: $mount_point"
    
    # Mount necessary filesystems
    mount --bind /dev "$mount_point/dev"
    mount --bind /dev/pts "$mount_point/dev/pts"
    mount --bind /proc "$mount_point/proc"
    mount --bind /sys "$mount_point/sys"
    
    # Copy resolv.conf for DNS
    cp /etc/resolv.conf "$mount_point/etc/resolv.conf"
    
    info "Entering chroot..."
    info "Type 'exit' to leave the chroot"
    
    # Chroot
    chroot "$mount_point" /bin/bash
    
    # Cleanup on exit
    info "Cleaning up mounts..."
    umount "$mount_point/dev/pts"
    umount "$mount_point/dev"
    umount "$mount_point/proc"
    umount "$mount_point/sys"
    
    info "Chroot exited"
}

# Show help
help() {
    cat << EOF
SigmaOS Chroot Tool v$VERSION

Usage: sigmaos-chroot [mount-point]

Chroot into a SigmaOS installation for maintenance or configuration.

Arguments:
    mount-point      Path to SigmaOS installation (default: /mnt)

Examples:
    sudo sigmaos-chroot /mnt
    sudo sigmaos-chroot /media/sigmaos

For more information, visit: https://github.com/AaryanSinghChauhan09/Sigma
EOF
}

# Main
case "$1" in
    help|--help|-h)
        help
        ;;
    *)
        chroot_sigmaos "$1"
        ;;
esac
